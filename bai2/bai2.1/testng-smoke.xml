<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="Smoke_Suite" verbose="1">

    <groups>
        <run>
            <include name="smoke"/>
        </run>
    </groups>

    <test name="Smoke Tests">
        <classes>
            <class name="dtm.LoginTest"/>
            <class name="dtm.CartTest"/>
            <class name="dtm.CheckoutTest"/>
        </classes>
    </test>

</suite>
