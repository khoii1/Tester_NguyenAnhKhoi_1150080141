<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Regression suite: runs all three groups (smoke + negative + boundary).
  Usage: mvn test -Dtestng.suite=testng-regression.xml
-->
<suite name="Lab9Bai3-Regression" verbose="1">
    <parameter name="browser" value="chrome"/>
    <parameter name="env" value="dev"/>

    <test name="Regression Login Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.lab9.tests.LoginDataDrivenTest"/>
        </classes>
    </test>
</suite>
