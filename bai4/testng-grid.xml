<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Grid Test Suite" parallel="tests" thread-count="4" verbose="1">

    <parameter name="env" value="dev"/>

    <!-- 2 test chạy chrome -->
    <test name="Chrome Test 1 - Login">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.lab9.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Chrome Test 2 - Demo">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.lab9.tests.BaseTestDemoTest"/>
        </classes>
    </test>

    <!-- 2 test chạy firefox -->
    <test name="Firefox Test 1 - Login">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.lab9.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Firefox Test 2 - Demo">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.lab9.tests.BaseTestDemoTest"/>
        </classes>
    </test>

</suite>
